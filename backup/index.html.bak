    <!-- ==========================================================================
         PROCESS SECTION (#process)
         ========================================================================== -->
    <section class="section section-padding" id="process">
      <div class="container">
        
        <div class="section-head">
          <div class="tag-label">HOW I WORK</div>
          <h2 class="title-display">ENGINEERING APPROACH</h2>
          <p class="subtitle-text">
            A simple, structured approach from planning through to delivery.
          </p>
        </div>

        <div class="process-3d-grid">
          
          <div class="process-card">
            <div class="process-phase">PLANNING</div>
            <h3 class="process-name">Planning &amp; Architecture</h3>
            <p class="process-body">
              Map system schemas, component relationships, and user flows before writing the first line of code.
            </p>
          </div>

          <div class="process-card">
            <div class="process-phase">DEVELOPMENT</div>
            <h3 class="process-name">Clean Implementation</h3>
            <p class="process-body">
              Build reusable, accessible UI elements and resilient backend REST endpoints with robust validation.
            </p>
          </div>

          <div class="process-card">
            <div class="process-phase">TESTING</div>
            <h3 class="process-name">Validation &amp; Testing</h3>
            <p class="process-body">
              Verify cross-device responsiveness, accessibility standards, and test edge cases to ensure stability.
            </p>
          </div>

          <div class="process-card">
            <div class="process-phase">DEPLOYMENT</div>
            <h3 class="process-name">Deployment &amp; Iteration</h3>
            <p class="process-body">
              Deploy with version control, verify live behavior, and iterate based on feedback and real use.
            </p>
          </div>

        </div>

      </div>
    </section>

