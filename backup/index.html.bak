  <title>Mandira Kalinga Dōna — 3D Portfolio | Software Engineer & MSc Data Science</title>
  <meta name="description" content="Portfolio of Mandira Kalinga Dōna. BSc (Hons) in Computer Science (2:1 Honours) & MSc Data Science Scholar at UWE Bristol. Full-Stack Software Engineer.">
  <meta name="author" content="Mandira Kalinga Dōna">
  <meta name="theme-color" content="#F8FAFC">

  <!-- Minimal Monogram Favicon -->
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2222%22 fill=%22%236366F1%22/><text x=%2250%25%22 y=%2255%25%22 font-family=%22system-ui%22 font-weight=%22900%22 font-size=%2252%22 fill=%22white%22 text-anchor=%22middle%22 dominant-baseline=%22middle%22>M</text></svg>">

  <!-- Google Fonts: Plus Jakarta Sans (Modern Display), Outfit (Geometric Tech), Inter (Clean Body), JetBrains Mono (Code/Tech) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Stylesheet -->
  <link rel="stylesheet" href="styles.css">
</head>
<body class="trending-3d-theme">

  <!-- Ambient Iridescent Mesh Background -->
  <div class="mesh-background" aria-hidden="true">
    <div class="mesh-orb orb-violet"></div>
    <div class="mesh-orb orb-cyan"></div>
    <div class="mesh-orb orb-mint"></div>
    <div class="mesh-grid"></div>
  </div>

  <!-- Custom Magnetic Cursor Indicator -->
  <div class="custom-cursor-dot" id="cursorDot" aria-hidden="true"></div>
  <div class="custom-cursor-ring" id="cursorRing" aria-hidden="true"></div>

  <!-- Floating Glass Header -->
  <header class="site-header" id="header" role="banner">
    <div class="header-container container">
      <a href="#hero" class="brand-logo" aria-label="Mandira Kalinga Dōna Home">
        <span class="logo-mark">M</span>
        <div class="logo-text-group">
          <span class="brand-name">MANDIRA</span>
          <span class="brand-dona">DŌNA</span>
        </div>
        <span class="live-status-dot" title="Open to Opportunities" aria-hidden="true"></span>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="nav-menu" role="navigation" aria-label="Main Navigation">
        <a href="#work" class="nav-link">Work</a>
        <a href="#about" class="nav-link">About</a>
        <a href="#skills" class="nav-link">Skills</a>
        <a href="#process" class="nav-link">Process</a>
        <a href="#education" class="nav-link">Education</a>
        <a href="#contact" class="nav-link">Contact</a>
      </nav>

      <!-- Nav CTA & Mobile Menu Trigger -->
      <div class="nav-actions">
        <a href="#work" class="btn-3d-subtle">
          <span>Explore Work</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </a>

        <button type="button" class="btn-3d-primary js-open-talk">
          <span class="btn-glare"></span>
          <span>Let's Talk</span>
        </button>

        <button class="mobile-nav-toggle" id="mobileMenuToggle" type="button" aria-label="Toggle navigation" aria-expanded="false">
          <span class="bar"></span>
          <span class="bar"></span>
          <span class="bar"></span>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile Drawer Menu -->
  <div class="mobile-drawer" id="mobileDrawer" role="dialog" aria-modal="true" aria-label="Mobile Navigation">
    <div class="mobile-drawer-links">
      <a href="#hero" class="mobile-drawer-link">Home</a>
      <a href="#work" class="mobile-drawer-link">Work</a>
      <a href="#about" class="mobile-drawer-link">About</a>
      <a href="#skills" class="mobile-drawer-link">Skills</a>
      <a href="#process" class="mobile-drawer-link">Process</a>
      <a href="#education" class="mobile-drawer-link">Education</a>
      <a href="#contact" class="mobile-drawer-link">Contact</a>
      <button type="button" class="mobile-drawer-link js-open-talk text-accent">
        Let's Talk ↗
      </button>
    </div>
    <div class="mobile-drawer-footer">
      <span class="mono-label">DIRECT EMAIL</span>
      <a href="mailto:mkavindidesilva@gmail.com" class="drawer-email">mkavindidesilva@gmail.com</a>
    </div>
  </div>

  <main id="mainContent">

    <!-- ==========================================================================
         HERO SECTION (3D Web Trending Canvas + Depth Composition)
         ========================================================================== -->
    <section class="hero-section" id="hero">
      <!-- 3D Network Matrix Design Background Canvas (Spans behind Name & Hero) -->
      <canvas id="heroBg3dCanvas" class="hero-bg-3d-canvas" aria-hidden="true"></canvas>

      <div class="container hero-container">
        
        <div class="hero-grid">
          
          <!-- Left Column: Typographic & Interactive Details -->
          <div class="hero-left">
            <div class="hero-status-pill">
              <span class="pulse-ring"></span>
              <span class="pill-text">Junior Software Engineer &amp; Full-Stack Developer</span>
            </div>

            <div class="hero-title-wrap">
              <span class="hero-eyebrow">Hi, I'm</span>
              <h1 class="hero-headline">
                <span class="name-first">Mandira Kalinga</span>
                <span class="name-dona-3d">DŌNA</span>
              </h1>
            </div>

            <div class="hero-role-pill">
              <span class="pill-bracket">{</span>
              <span class="pill-role">SOFTWARE ENGINEER</span>
              <span class="pill-bracket">}</span>
              <span class="pill-sep">//</span>
              <span class="pill-edu">FULL-STACK &amp; DATA SYSTEMS</span>
            </div>

            <p class="hero-lead">
              I'm early in my career, and every project is still a chance to learn something new. I build web platforms from the ground up, and I gravitate toward the ones that make me think harder than I expected. See for yourself below.
            </p>

            <div class="hero-buttons">
              <a href="#work" class="btn-3d-main">
                <span>View Selected Projects</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
              </a>

              <button type="button" class="btn-3d-glass js-open-talk">
                <span class="dot-online"></span>
                <span>Let's Talk</span>
              </button>

              <button type="button" class="btn-copy-quick" id="quickCopyEmailBtn" title="Copy email address">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                <span>mkavindidesilva@gmail.com</span>
              </button>
            </div>

            <!-- Social Links Strip -->
            <div class="hero-socials">
              <a href="https://github.com/mandirads" target="_blank" rel="noopener noreferrer" class="social-pill">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                <span>github.com/mandirads</span>
              </a>
              <a href="https://www.linkedin.com/in/mandiradesilva3/" target="_blank" rel="noopener noreferrer" class="social-pill">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                <span>linkedin/mandiradesilva3</span>
              </a>
            </div>
          </div>

          <!-- Right Column: Interactive 3D Web Canvas & Holographic Cards -->
          <div class="hero-right">
            <div class="interactive-3d-stage" id="stage3d">
              <!-- 3D Canvas dynamically rendered by script.js -->
              <canvas id="hero3dCanvas" class="hero-3d-canvas" aria-label="Interactive 3D Geometric Scene"></canvas>
              
              <!-- Hero Featured Portrait Card (Prominent & High-Res) -->
              <div class="hero-portrait-card tilt-elem" data-depth="0.18">
                <div class="hero-portrait-frame">
                  <img src="images/profile_retouched_bw.jpg" alt="Mandira Kalinga Dōna" class="hero-portrait-img">
                  <div class="hero-portrait-badge">
                    <span class="dot-online"></span>
                    <span>Mandira Kalinga Dōna</span>
                  </div>
                </div>
              </div>

              <!-- Floating Holographic Badge 1: Career Readiness & Opportunity -->
              <div class="floating-holo-tag holo-top-right tilt-elem" data-depth="0.12">
                <span class="holo-icon live-dot">●</span>
                <div class="holo-text">
                  <span class="holo-title">Open for Opportunities</span>
                  <span class="holo-sub">Junior Engineer &amp; Graduate Roles</span>
                </div>
              </div>

              <!-- Floating Holographic Badge 2: Tech Stack -->
              <div class="floating-holo-tag holo-bottom-left tilt-elem" data-depth="0.22">
                <span class="holo-icon">✦</span>
                <div class="holo-text">
                  <span class="holo-title">Tech Stack</span>
                  <span class="holo-sub">Frontend, Backend &amp; Systems</span>
