    <!-- ==========================================================================
         WORK SECTION (#work - 3D Interactive Tilt Cards)
         ========================================================================== -->
    <section class="section section-padding" id="work">
      <div class="container">
        
        <div class="section-head">
          <div class="tag-label">SELECTED PROJECTS</div>
          <h2 class="title-display">FEATURED PROJECTS</h2>
          <p class="subtitle-text">
            A selection of projects exploring full-stack web platforms, responsive interfaces, and data systems.
          </p>
        </div>

        <!-- 3D Category Dock -->
        <div class="filter-dock-wrap">
          <div class="filter-dock-3d" role="tablist" aria-label="Filter Projects">
            <button class="filter-chip is-active" type="button" data-filter="all" role="tab" aria-selected="true">
              <span>ALL</span>
              <span class="chip-counter">3</span>
            </button>
            <button class="filter-chip" type="button" data-filter="fullstack" role="tab" aria-selected="false">
              <span>FULL STACK</span>
              <span class="chip-counter">1</span>
            </button>
            <button class="filter-chip" type="button" data-filter="frontend" role="tab" aria-selected="false">
              <span>FRONTEND &amp; WEB</span>
              <span class="chip-counter">1</span>
            </button>
            <button class="filter-chip" type="button" data-filter="datascience" role="tab" aria-selected="false">
              <span>DATA &amp; CS</span>
              <span class="chip-counter">1</span>
            </button>
          </div>
        </div>

        <!-- 3D Tilt Project Cards Grid -->
        <div class="projects-3d-grid" id="projectsGrid">
          
          <!-- Card 1: Full-Stack -->
          <article class="card-3d-tilt" data-category="fullstack">
            <div class="card-glare" aria-hidden="true"></div>
            <div class="card-glass-body">
              <div class="card-head-bar">
                <span class="index-badge">FULL-STACK</span>
                <span class="status-pill-amber">In Progress</span>
              </div>

              <h3 class="card-project-title">Full-Stack Web Application</h3>
              <p class="card-project-desc">
                A modular web application featuring a responsive frontend, RESTful API controllers, and relational database data modeling.
              </p>

              <div class="card-bullets">
                <div class="bullet-row">
                  <span class="bullet-arrow">›</span>
                  <span>Responsive user interface with clean component hierarchy and state management.</span>
                </div>
                <div class="bullet-row">
                  <span class="bullet-arrow">›</span>
                  <span>Structured REST API endpoints with input validation and error handling.</span>
                </div>
              </div>

              <div class="card-tech-chips">
                <span class="tech-chip">JavaScript</span>
                <span class="tech-chip">React</span>
                <span class="tech-chip">Node.js</span>
                <span class="tech-chip">PostgreSQL</span>
              </div>

              <div class="card-foot-actions">
                <a href="https://github.com/mandirads" target="_blank" rel="noopener noreferrer" class="link-action">
                  <span>GitHub Repository</span>
                </a>
                <a href="https://github.com/mandirads" target="_blank" rel="noopener noreferrer" class="btn-chip-demo">
                  <span>Demo (Coming Soon)</span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                </a>
              </div>
            </div>
          </article>

          <!-- Card 2: Interactive Frontend -->
          <article class="card-3d-tilt" data-category="frontend">
            <div class="card-glare" aria-hidden="true"></div>
            <div class="card-glass-body">
              <div class="card-head-bar">
                <span class="index-badge">FRONTEND</span>
                <span class="status-pill-amber">In Progress</span>
              </div>

              <h3 class="card-project-title">Interactive Web Platform</h3>
              <p class="card-project-desc">
                A responsive client application focused on smooth interactive elements, state transitions, and external API integration.
              </p>

              <div class="card-bullets">
                <div class="bullet-row">
                  <span class="bullet-arrow">›</span>
                  <span>Asynchronous data fetching with dynamic UI updates and loading states.</span>
                </div>
                <div class="bullet-row">
                  <span class="bullet-arrow">›</span>
                  <span>Optimized client-side rendering for fast load times and clean responsiveness.</span>
                </div>
              </div>

              <div class="card-tech-chips">
                <span class="tech-chip">HTML5</span>
                <span class="tech-chip">CSS3 / Flexbox</span>
                <span class="tech-chip">JavaScript (ES6+)</span>
                <span class="tech-chip">UI/UX</span>
              </div>

              <div class="card-foot-actions">
                <a href="https://github.com/mandirads" target="_blank" rel="noopener noreferrer" class="link-action">
                  <span>GitHub Repository</span>
                </a>
                <a href="https://github.com/mandirads" target="_blank" rel="noopener noreferrer" class="btn-chip-demo">
                  <span>Demo (Coming Soon)</span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                </a>
              </div>
            </div>
          </article>

          <!-- Card 3: Data Science Engine -->
          <article class="card-3d-tilt" data-category="datascience">
            <div class="card-glare" aria-hidden="true"></div>
            <div class="card-glass-body">
              <div class="card-head-bar">
                <span class="index-badge">DATA &amp; ALGORITHMS</span>
                <span class="status-pill-amber">In Progress</span>
              </div>

              <h3 class="card-project-title">Data Analytics &amp; Algorithms</h3>
              <p class="card-project-desc">
                Data exploration pipelines and algorithmic problem solving using Python, Pandas, and structured SQL.
              </p>

              <div class="card-bullets">
                <div class="bullet-row">
                  <span class="bullet-arrow">›</span>
                  <span>Automated data cleaning, statistical evaluation, and visual summaries.</span>
                </div>
                <div class="bullet-row">
                  <span class="bullet-arrow">›</span>
                  <span>Evaluated core data structures and search algorithms for computational efficiency.</span>
                </div>
              </div>

              <div class="card-tech-chips">
                <span class="tech-chip">Python</span>
                <span class="tech-chip">Pandas / NumPy</span>
                <span class="tech-chip">SQL</span>
                <span class="tech-chip">Algorithms</span>
              </div>

              <div class="card-foot-actions">
                <a href="https://github.com/mandirads" target="_blank" rel="noopener noreferrer" class="link-action">
                  <span>GitHub Repository</span>
                </a>
                <a href="https://github.com/mandirads" target="_blank" rel="noopener noreferrer" class="btn-chip-demo">
                  <span>Demo (Coming Soon)</span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                </a>
              </div>
            </div>
          </article>

        </div>

        <!-- Customizer Callout -->
        <div class="glass-callout-strip">
          <span class="callout-glyph">✦</span>
          <p class="callout-msg">
            More project code and technical experiments are available on my <a href="https://github.com/mandirads" target="_blank" rel="noopener noreferrer" style="color:var(--accent-indigo);font-weight:600;text-decoration:underline;">GitHub profile</a>.
          </p>
        </div>

      </div>
    </section>

    <!-- ==========================================================================
         ABOUT SECTION (#about)
         ========================================================================== -->
    <section class="section section-padding" id="about">
      <div class="container">
        
        <div class="section-head">
          <div class="tag-label">ABOUT ME</div>
          <h2 class="title-display">BACKGROUND &amp; FOCUS</h2>
          <p class="subtitle-text">
            Computer Science graduate reading for an MSc in Data Science at the University of the West of England (UWE Bristol).
          </p>
        </div>

        <div class="about-3d-layout">
          <!-- Portrait Card -->
          <div class="glass-panel-card about-portrait-card">
            <div class="portrait-img-wrap">
              <img src="images/profile_retouched_bw.jpg" alt="Mandira Kalinga Dōna" class="portrait-img">
              <div class="portrait-status-badge">
                <span class="dot-online"></span>
                <span>Open for Opportunities</span>
              </div>
            </div>
            <div class="portrait-meta">
              <h3 class="portrait-name">Mandira Kalinga Dōna</h3>
              <p class="portrait-title">Junior Software Engineer</p>
              <div class="portrait-tags">
                <span class="ptag">BSc (Hons) 2:1 CS</span>
                <span class="ptag">MSc Data Science</span>
              </div>
              <div class="portrait-location">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                <span>Bristol, UK • Open to Relocate</span>
              </div>
            </div>
          </div>

          <!-- Main Narrative Glass Card -->
          <div class="glass-panel-card">
            <h3 class="panel-heading">Background &amp; Goals</h3>
            <p>
              I graduated with a <strong>BSc (Hons) in Computer Science (2:1 Honours)</strong> from the <strong>University of the West of England (UWE Bristol)</strong>, and I am currently reading for an <strong>MSc in Data Science at UWE Bristol</strong>.
            </p>
            <p>
              I enjoy building web platforms and working with data. Whether crafting a responsive interface or structuring an API, I focus on writing clear, maintainable code and understanding how things work under the hood.
            </p>
            <p>
              I am actively looking for graduate and junior software engineering roles where I can learn from experienced engineers, contribute to real-world products, and continue growing as a developer.
            </p>

            <div class="metrics-trio">
              <div class="metric-box">
                <span class="metric-num">2:1</span>
                <span class="metric-sub">BSc (Hons) CS</span>
              </div>
              <div class="metric-box">
                <span class="metric-num">MSc</span>
                <span class="metric-sub">Data Science (In Progress)</span>
              </div>
              <div class="metric-box">
                <span class="metric-num">Bristol, UK</span>
                <span class="metric-sub">Open to Relocate</span>
              </div>
            </div>
          </div>

          <!-- Pillars Card -->
          <div class="glass-panel-card">
            <h3 class="panel-heading">Areas of Focus</h3>
            <div class="pillars-container">
              <div class="pillar-block">
                <span class="pillar-icon">✦</span>
                <div>
                  <h4>Web &amp; Full-Stack Development</h4>
                  <p>Building responsive, accessible web interfaces and connected backend services using JavaScript, React, and Node.js.</p>
                </div>
              </div>
              <div class="pillar-block">
                <span class="pillar-icon">✦</span>
                <div>
                  <h4>Data Science &amp; Analytics</h4>
                  <p>Developing data pipelines, applying machine learning algorithms, and modeling data using Python &amp; SQL.</p>
                </div>
              </div>
              <div class="pillar-block">
                <span class="pillar-icon">✦</span>
                <div>
                  <h4>Computer Science Foundations</h4>
                  <p>Applying core data structures, algorithm design, and clean modular architecture.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

