    <!-- ==========================================================================
         SKILLS SECTION (#skills)
         ========================================================================== -->
    <section class="section section-padding" id="skills">
      <div class="container">
        
        <div class="section-head">
          <div class="tag-label">SKILLS &amp; TECHNOLOGIES</div>
          <h2 class="title-display">TECHNICAL SKILLS</h2>
          <p class="subtitle-text">
            Technologies, programming languages, and analytical tools I work with.
          </p>
        </div>

        <div class="skills-3d-grid">
          
