  <!-- "LET'S TALK" MODAL DIALOG -->
  <div class="talk-modal-overlay" id="talkModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle" aria-hidden="true">
    <div class="talk-modal-card">
      <div class="modal-header">
        <div>
          <span class="modal-tag">DIRECT COMMUNICATION</span>
          <h3 class="modal-title" id="modalTitle">Let's talk about an opportunity</h3>
        </div>
        <button type="button" class="modal-close-btn" id="modalCloseBtn" aria-label="Close dialog">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>

      <div class="modal-body">
        <div class="modal-quick-email">
          <div class="quick-email-details">
            <span class="quick-label">DIRECT EMAIL</span>
            <span class="quick-val">mkavindidesilva@gmail.com</span>
          </div>
          <button type="button" class="btn-copy-modal" id="modalCopyEmailBtn">
            <span>Copy</span>
          </button>
        </div>

        <form id="modalContactForm" class="modal-form">
          <div class="form-row">
            <div class="form-group">
              <label for="mName">Your Name</label>
              <input type="text" id="mName" required placeholder="Alex Morgan">
            </div>
            <div class="form-group">
              <label for="mEmail">Your Email</label>
              <input type="email" id="mEmail" required placeholder="alex@company.com">
            </div>
          </div>
          <div class="form-group">
            <label for="mSubject">Subject / Role</label>
            <input type="text" id="mSubject" required placeholder="Junior Software Engineer Opportunity">
          </div>
          <div class="form-group">
            <label for="mMessage">Message</label>
            <textarea id="mMessage" rows="3" required placeholder="Hi Mandira, we saw your portfolio and would love to discuss an opportunity..."></textarea>
          </div>
          <button type="submit" class="btn-modal-submit">
            <span>Send Message via Email Client</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Toast Notification Alert -->
  <div id="toastNotification" class="toast-card" role="status" aria-live="polite">
    <span class="toast-check">✓</span>
    <span class="toast-text" id="toastMessage">Copied to clipboard!</span>
  </div>

