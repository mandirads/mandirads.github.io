/* ==========================================================================
   Mandira Kalinga Dōna — 3D Trending Web Portfolio Stylesheet
   Contemporary Creative Studio Aesthetic: Frosted Holographic Glass,
   Iridescent Gradients, 3D Canvas Stage, and Card Tilt Physics
   ========================================================================== */

/* --------------------------------------------------------------------------
   CSS Variables & Design Tokens
   -------------------------------------------------------------------------- */
:root {
  /* Futuristic Light Studio Canvas */
  --bg-body: #F8FAFC;
  --bg-surface: rgba(255, 255, 255, 0.78);
  --bg-card: rgba(255, 255, 255, 0.82);
  --bg-card-hover: rgba(255, 255, 255, 0.96);
  --bg-subtle: rgba(241, 245, 249, 0.8);
  --bg-header: rgba(248, 250, 252, 0.85);
  --bg-overlay: rgba(15, 23, 42, 0.5);

  /* Clean Matte Tech Blue Accents (No Purple) */
  --accent-indigo: #2563EB;
  --accent-violet: #1E40AF;
  --accent-cyan: #0284C7;
  --accent-mint: #0EA5E9;
  
  --gradient-holo: linear-gradient(135deg, #1E40AF 0%, #2563EB 50%, #0284C7 100%);
  --gradient-subtle: linear-gradient(135deg, rgba(37, 99, 235, 0.08) 0%, rgba(2, 132, 199, 0.08) 100%);
  --gradient-border: linear-gradient(135deg, rgba(37, 99, 235, 0.4), rgba(2, 132, 199, 0.4));

  /* Text Colors */
  --text-primary: #090E17;
  --text-secondary: #475569;
  --text-muted: #64748B;
  --text-subtle: #94A3B8;
  --text-white: #FFFFFF;

  /* Borders & Glass */
  --border-glass: rgba(255, 255, 255, 0.9);
  --border-subtle: rgba(226, 232, 240, 0.85);
  --border-active: #6366F1;

  /* Status Colors */
  --status-green: #10B981;
  --status-green-bg: rgba(16, 185, 129, 0.1);
  --status-green-border: rgba(16, 185, 129, 0.25);
  --status-amber: #D97706;
  --status-amber-bg: rgba(245, 158, 11, 0.1);
  --status-amber-border: rgba(245, 158, 11, 0.25);

  /* Typography */
  --font-display: 'Plus Jakarta Sans', 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-body: 'Plus Jakarta Sans', 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-mono: 'Plus Jakarta Sans', 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;

  /* 3D Shadows & Glass Elevation */
  --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.03);
  --shadow-glass: 0 20px 40px -15px rgba(99, 102, 241, 0.08), 0 0 0 1px var(--border-glass), 0 1px 3px rgba(0, 0, 0, 0.04);
  --shadow-glass-hover: 0 30px 60px -20px rgba(99, 102, 241, 0.18), 0 0 0 1px var(--accent-indigo);

  /* Radius & Curves */
  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 22px;
  --radius-full: 9999px;

  /* Transitions */
  --ease-3d: cubic-bezier(0.16, 1, 0.3, 1);
  --trans-fast: 160ms var(--ease-3d);
  --trans-normal: 320ms var(--ease-3d);
}

/* --------------------------------------------------------------------------
   Global Reset & Base
   -------------------------------------------------------------------------- */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  font-size: 16px;
  background-color: var(--bg-body);
  color: var(--text-primary);
  -webkit-text-size-adjust: 100%;
}

body {
  font-family: var(--font-body);
  background-color: var(--bg-body);
  color: var(--text-primary);
  line-height: 1.6;
  overflow-x: hidden;
  position: relative;
  min-height: 100vh;
}

::selection {
  background: var(--accent-indigo);
  color: #FFFFFF;
}

:focus-visible {
  outline: 2px solid var(--accent-indigo);
  outline-offset: 3px;
}

a {
  color: inherit;
  text-decoration: none;
  transition: color var(--trans-fast);
}

button {
  cursor: pointer;
  background: none;
  border: none;
  font: inherit;
  color: inherit;
}

.container {
  width: 100%;
  max-width: 1240px;
  margin: 0 auto;
  padding: 0 clamp(1.25rem, 4vw, 3rem);
}

.section-padding {
  padding: clamp(5rem, 9vw, 8rem) 0;
}

/* --------------------------------------------------------------------------
   Ambient Iridescent Mesh Background
   -------------------------------------------------------------------------- */
.mesh-background {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.mesh-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(140px);
  pointer-events: none;
  will-change: transform;
}

.orb-violet {
  top: -80px;
  right: -50px;
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.14) 0%, rgba(139, 92, 246, 0) 70%);
  animation: floatOrb 18s ease-in-out infinite alternate;
}

.orb-cyan {
  top: 35%;
  left: -180px;
  width: 700px;
  height: 700px;
  background: radial-gradient(circle, rgba(6, 182, 212, 0.12) 0%, rgba(6, 182, 212, 0) 70%);
  animation: floatOrb 22s ease-in-out infinite alternate-reverse;
}

.orb-mint {
  bottom: -100px;
  right: 15%;
  width: 550px;
  height: 550px;
  background: radial-gradient(circle, rgba(16, 185, 129, 0.09) 0%, rgba(16, 185, 129, 0) 70%);
}

@keyframes floatOrb {
  0% { transform: translate(0, 0) scale(1); }
  100% { transform: translate(40px, -50px) scale(1.08); }
}

.mesh-grid {
  position: absolute;
  inset: 0;
  background-image: linear-gradient(rgba(0, 0, 0, 0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(0, 0, 0, 0.02) 1px, transparent 1px);
  background-size: 40px 40px;
  opacity: 0.8;
}

/* --------------------------------------------------------------------------
   Custom Magnetic Cursor Indicator (Desktop)
   -------------------------------------------------------------------------- */
.custom-cursor-dot {
  position: fixed;
  top: 0;
  left: 0;
  width: 6px;
  height: 6px;
  background: var(--accent-indigo);
  border-radius: 50%;
  pointer-events: none;
  z-index: 9999;
  transform: translate(-50%, -50%);
  transition: transform 0.08s ease-out;
}

.custom-cursor-ring {
  position: fixed;
  top: 0;
  left: 0;
  width: 32px;
  height: 32px;
  border: 1.5px solid rgba(99, 102, 241, 0.4);
  border-radius: 50%;
  pointer-events: none;
  z-index: 9998;
  transform: translate(-50%, -50%);
  transition: width 0.2s ease, height 0.2s ease, border-color 0.2s ease, transform 0.15s ease-out;
}

/* --------------------------------------------------------------------------
   Floating Glass Header
   -------------------------------------------------------------------------- */
.site-header {
  position: sticky;
  top: 1rem;
  width: 100%;
  z-index: 500;
}

.header-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 68px;
  background: var(--bg-header);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-full);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
  padding: 0 1.75rem;
}

.brand-logo {
  display: flex;
  align-items: center;
  gap: 0.65rem;
}

.logo-mark {
  font-family: var(--font-display);
  font-size: 0.95rem;
  font-weight: 800;
  color: #FFFFFF;
  background: var(--gradient-holo);
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  box-shadow: 0 4px 12px rgba(99, 102, 241, 0.35);
}

.logo-text-group {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  font-family: var(--font-display);
}

.brand-name {
  font-size: 0.95rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  color: var(--text-primary);
}

.brand-dona {
  font-size: 0.95rem;
  font-weight: 900;
  letter-spacing: 0.06em;
  color: var(--accent-indigo);
}

.live-status-dot {
  width: 7px;
  height: 7px;
  background-color: var(--status-green);
  border-radius: 50%;
  box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
  animation: pulseStatus 2s infinite;
  margin-left: 0.15rem;
}

@keyframes pulseStatus {
  0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.6); }
  70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
  100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
}

.nav-menu {
  display: flex;
  align-items: center;
  gap: 1.75rem;
}

.nav-link {
  font-family: var(--font-display);
  font-size: 0.9375rem;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: var(--text-secondary);
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  transition: color var(--trans-fast);
}

.nav-link span {
  font-family: var(--font-display);
  font-size: 0.8125rem;
  color: var(--accent-indigo);
  font-weight: 700;
}

.nav-link:hover, .nav-link.active {
  color: var(--accent-indigo);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.btn-3d-subtle {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  font-family: var(--font-display);
  font-size: 0.8125rem;
  font-weight: 600;
  letter-spacing: 0.01em;
  color: var(--text-secondary);
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  padding: 0.45rem 1rem;
  border-radius: var(--radius-full);
  transition: all var(--trans-fast);
}

.btn-3d-subtle:hover {
  border-color: var(--accent-indigo);
  color: var(--accent-indigo);
  transform: translateY(-1px);
}

.btn-3d-primary {
  position: relative;
  overflow: hidden;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 0.85rem;
  font-weight: 700;
  color: #FFFFFF;
  background: var(--gradient-holo);
  padding: 0.55rem 1.25rem;
  border-radius: var(--radius-full);
  box-shadow: 0 4px 16px rgba(99, 102, 241, 0.3);
  transition: all var(--trans-fast);
}

.btn-3d-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(99, 102, 241, 0.45);
}

.mobile-nav-toggle {
  display: none;
  flex-direction: column;
  gap: 5px;
  padding: 0.45rem;
}

.mobile-nav-toggle .bar {
  width: 20px;
  height: 2px;
  background: var(--text-primary);
  border-radius: 2px;
}

/* --------------------------------------------------------------------------
   Mobile Drawer Menu
   -------------------------------------------------------------------------- */
.mobile-drawer {
  position: fixed;
  top: 80px;
  left: 0;
  width: 100%;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  border-bottom: 1px solid var(--border-subtle);
  padding: 2rem clamp(1.5rem, 5vw, 3rem);
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  transform: translateY(-130%);
  opacity: 0;
  pointer-events: none;
  transition: all var(--trans-normal);
  z-index: 490;
}

.mobile-drawer.open {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}

.mobile-drawer-links {
  display: flex;
  flex-direction: column;
  gap: 1.15rem;
}

.mobile-drawer-link {
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--text-primary);
}

.mobile-drawer-link.text-accent {
  color: var(--accent-indigo);
}

.mobile-drawer-footer {
  padding-top: 1.25rem;
  border-top: 1px solid var(--border-subtle);
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

/* --------------------------------------------------------------------------
   HERO SECTION (3D Web Trending Canvas + Depth Composition)
   -------------------------------------------------------------------------- */
.hero-section {
  padding: clamp(3.5rem, 7vw, 6rem) 0 clamp(2.5rem, 5vw, 4rem) 0;
  position: relative;
  z-index: 1;
  overflow: hidden;
}

/* 3D Network Matrix Design Background Canvas */
.hero-bg-3d-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
  opacity: 0.92;
}

.hero-container {
  position: relative;
  z-index: 1;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.25fr 1fr;
  gap: clamp(2rem, 5vw, 4.5rem);
  align-items: center;
}

.hero-status-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  background: var(--status-green-bg);
  border: 1px solid var(--status-green-border);
  color: var(--status-green);
  padding: 0.35rem 0.85rem;
  border-radius: var(--radius-full);
  font-size: 0.8125rem;
  font-weight: 600;
  margin-bottom: 1.25rem;
  box-shadow: 0 2px 10px rgba(16, 185, 129, 0.12);
}

.pulse-ring {
  width: 6px;
  height: 6px;
  background: var(--status-green);
  border-radius: 50%;
}

.hero-title-wrap {
  position: relative;
  margin-bottom: 1.25rem;
}

.hero-eyebrow {
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 0.35rem;
  letter-spacing: -0.01em;
}

.hero-headline {
  font-family: var(--font-display);
  font-size: clamp(2.8rem, 6.2vw, 5rem);
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: -0.035em;
  color: #0F172A;
}

.name-first {
  display: block;
  color: #0F172A;
}

/* Matte High-End DŌNA (No purple, no neon gradient, pure matte precision) */
.name-dona-3d {
  display: inline-block;
  font-size: clamp(3rem, 6.8vw, 5.4rem);
  font-weight: 800;
  letter-spacing: -0.01em;
  text-transform: uppercase;
  color: #1E40AF; /* Deep Matte Cobalt Navy */
  position: relative;
  margin-top: 0.1rem;
}

.hero-role-pill {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.55rem;
  font-family: var(--font-display);
  font-size: 0.875rem;
  font-weight: 700;
  letter-spacing: 0.03em;
  color: var(--text-secondary);
  margin-bottom: 1.75rem;
}

.pill-bracket {
  color: var(--accent-indigo);
  font-weight: 800;
  font-size: 0.95rem;
}

.pill-role {
  color: #0F172A;
  font-weight: 800;
}

.pill-sep {
  color: var(--accent-cyan);
  font-weight: 800;
}

.pill-edu {
  color: var(--text-secondary);
  font-weight: 700;
}

.hero-lead {
  font-size: clamp(1rem, 1.8vw, 1.15rem);
  color: var(--text-secondary);
  line-height: 1.65;
  margin-bottom: 2.25rem;
  max-width: 620px;
}

.hero-buttons {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.85rem;
  margin-bottom: 2rem;
}

.btn-3d-main {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  font-size: 0.9375rem;
  font-weight: 700;
  color: #FFFFFF;
  background: var(--text-primary);
  padding: 0.85rem 1.65rem;
  border-radius: var(--radius-full);
  box-shadow: 0 8px 20px rgba(9, 14, 23, 0.18);
  transition: all var(--trans-fast);
}

.btn-3d-main:hover {
  background: var(--accent-indigo);
  color: #FFFFFF;
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(99, 102, 241, 0.35);
}

.btn-3d-glass {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  font-size: 0.9375rem;
  font-weight: 700;
  color: var(--text-primary);
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  padding: 0.85rem 1.5rem;
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-sm);
  transition: all var(--trans-fast);
}

.btn-3d-glass:hover {
  border-color: var(--accent-indigo);
  color: var(--accent-indigo);
  transform: translateY(-2px);
}

.btn-copy-quick {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-display);
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--text-secondary);
  background: var(--bg-subtle);
  border: 1px solid var(--border-subtle);
  padding: 0.75rem 1.15rem;
  border-radius: var(--radius-full);
  transition: all var(--trans-fast);
}

.btn-copy-quick:hover {
  border-color: var(--accent-cyan);
  color: var(--accent-indigo);
  background: #FFFFFF;
}

.dot-online {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #10B981;
}

.hero-socials {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  flex-wrap: wrap;
}

.social-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-muted);
  transition: all var(--trans-fast);
}

.social-pill:hover {
  color: var(--accent-indigo);
  transform: translateY(-1px);
}

/* --------------------------------------------------------------------------
   3D STAGE & THREE.JS CANVAS
   -------------------------------------------------------------------------- */
.interactive-3d-stage {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  max-width: 520px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  box-shadow: none;
  overflow: visible;
}

.hero-3d-canvas {
  width: 100% !important;
  height: 100% !important;
  display: block;
  border-radius: 0;
  border: none;
  outline: none;
  background: transparent;
  box-shadow: none;
  pointer-events: auto;
  cursor: grab;
}

.hero-3d-canvas:active {
  cursor: grabbing;
}

/* Hero Central Portrait Card */
.hero-portrait-card {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: min(320px, 78%);
  aspect-ratio: 1 / 1;
  z-index: 5;
  pointer-events: auto;
}

.hero-portrait-frame {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 28px;
  overflow: hidden;
  box-shadow: 0 24px 60px rgba(15, 23, 42, 0.16), 0 0 0 1px rgba(30, 64, 175, 0.15);
  background: var(--bg-card);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  transition: transform var(--trans-fast), box-shadow var(--trans-fast);
}

.hero-portrait-card:hover .hero-portrait-frame {
  transform: scale(1.02);
  box-shadow: 0 28px 70px rgba(30, 64, 175, 0.22), 0 0 0 2px var(--accent-indigo);
}

.hero-portrait-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.hero-portrait-badge {
  position: absolute;
  bottom: 0.85rem;
  left: 0.85rem;
  right: 0.85rem;
  padding: 0.45rem 0.85rem;
  border-radius: var(--radius-full);
  background: rgba(15, 23, 42, 0.85);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: #F8FAFC;
  font-size: 0.78rem;
  font-weight: 700;
  justify-content: center;
  letter-spacing: 0.01em;
}

/* Floating 3D Holographic Badges */
.floating-holo-tag {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--border-glass);
  padding: 0.85rem 1.25rem;
  border-radius: var(--radius-md);
  box-shadow: 0 16px 36px -8px rgba(99, 102, 241, 0.15), 0 0 0 1px rgba(255, 255, 255, 0.9);
  pointer-events: none;
  z-index: 10;
  transition: transform 0.2s var(--ease-3d);
}

.holo-top-right {
  top: 8%;
  right: -5%;
  animation: floatHoloA 7s ease-in-out infinite;
}

.holo-bottom-left {
  bottom: 8%;
  left: -5%;
  animation: floatHoloB 8s ease-in-out infinite;
}

@keyframes floatHoloA {
  0%, 100% { transform: translateY(0px) rotate(0deg); }
  50% { transform: translateY(-10px) rotate(1deg); }
}

@keyframes floatHoloB {
  0%, 100% { transform: translateY(0px) rotate(0deg); }
  50% { transform: translateY(10px) rotate(-1deg); }
}

.holo-icon {
  font-size: 1.1rem;
  color: var(--accent-indigo);
}

.holo-icon.live-dot {
  color: var(--status-green);
  font-size: 0.95rem;
  animation: pulseLiveDot 2.2s infinite ease-in-out;
}

@keyframes pulseLiveDot {
  0%, 100% { transform: scale(0.92); opacity: 0.75; }
  50% { transform: scale(1.2); opacity: 1; filter: drop-shadow(0 0 6px rgba(16, 185, 129, 0.8)); }
}

.holo-text {
  display: flex;
  flex-direction: column;
}

.holo-title {
  font-family: var(--font-display);
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--text-primary);
}

.holo-sub {
  font-size: 0.75rem;
  color: var(--text-muted);
}

/* Hero Bottom Bar */
.hero-bottom-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1.5rem;
  margin-top: clamp(3rem, 6vw, 4.5rem);
  padding-top: 1.75rem;
  border-top: 1px solid var(--border-subtle);
}

.bottom-metric-badge {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  font-size: 0.9rem;
}

.metric-lead {
  color: var(--text-muted);
}

.metric-value {
  font-weight: 700;
  color: var(--accent-indigo);
}

.scroll-prompt {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  font-family: var(--font-mono);
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--text-secondary);
}

.scroll-prompt:hover {
  color: var(--accent-indigo);
  transform: translateY(2px);
}

/* --------------------------------------------------------------------------
   SHARED SECTION HEADINGS
   -------------------------------------------------------------------------- */
.section-head {
  margin-bottom: clamp(2.5rem, 5vw, 4rem);
}

.tag-label {
  font-family: var(--font-display);
  font-size: 0.8125rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--accent-indigo);
  text-transform: uppercase;
  margin-bottom: 0.55rem;
}

.title-display {
  font-family: var(--font-display);
  font-size: clamp(2.2rem, 4.5vw, 3.4rem);
  font-weight: 900;
  letter-spacing: -0.03em;
  color: var(--text-primary);
  margin-bottom: 0.75rem;
}

.subtitle-text {
  font-size: clamp(1rem, 1.8vw, 1.15rem);
  color: var(--text-secondary);
  max-width: 680px;
}

/* --------------------------------------------------------------------------
   WORK SECTION (#work - 3D Interactive Tilt Cards)
   -------------------------------------------------------------------------- */
.filter-dock-wrap {
  margin-bottom: 2.5rem;
}

.filter-dock-3d {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(16px);
  padding: 0.35rem;
  border-radius: var(--radius-full);
  border: 1px solid var(--border-subtle);
  box-shadow: var(--shadow-sm);
  flex-wrap: wrap;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.45rem 1.05rem;
  border-radius: var(--radius-full);
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: var(--text-secondary);
  transition: all var(--trans-fast);
}

.filter-chip:hover {
  color: var(--text-primary);
}

.filter-chip.is-active {
  background: var(--text-primary);
  color: #FFFFFF;
  box-shadow: 0 4px 12px rgba(9, 14, 23, 0.15);
}

.chip-counter {
  font-size: 0.6875rem;
  background: var(--bg-subtle);
  color: var(--text-muted);
  padding: 0.1rem 0.45rem;
  border-radius: var(--radius-full);
}

.filter-chip.is-active .chip-counter {
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
}

/* 3D Tilt Cards Grid */
.projects-3d-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
  gap: 2rem;
  perspective: 1200px;
}

.card-3d-tilt {
  position: relative;
  background: var(--bg-card);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--border-glass);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-glass);
  transform-style: preserve-3d;
  transition: box-shadow var(--trans-normal), border-color var(--trans-normal);
  overflow: hidden;
}

.card-3d-tilt:hover {
  box-shadow: var(--shadow-glass-hover);
  border-color: rgba(99, 102, 241, 0.4);
}

.card-3d-tilt.hidden {
  display: none;
}

.card-glare {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.5) 0%, transparent 65%);
  opacity: 0;
  transition: opacity 0.2s ease;
  z-index: 10;
}

.card-3d-tilt:hover .card-glare {
  opacity: 1;
}

.card-glass-body {
  padding: 2rem;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.card-head-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.25rem;
}

.index-badge {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--accent-indigo);
}

.status-pill-amber {
  font-size: 0.75rem;
  font-weight: 600;
  padding: 0.25rem 0.65rem;
  border-radius: var(--radius-full);
  background: var(--status-amber-bg);
  color: var(--status-amber);
  border: 1px solid var(--status-amber-border);
}

.card-project-title {
  font-family: var(--font-display);
  font-size: 1.35rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 0.75rem;
}

.card-project-desc {
  font-size: 0.9375rem;
  color: var(--text-secondary);
  line-height: 1.55;
  margin-bottom: 1.25rem;
}

.card-bullets {
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
  margin-bottom: 1.5rem;
  font-size: 0.875rem;
  color: var(--text-secondary);
}

.bullet-row {
  display: flex;
  gap: 0.55rem;
  align-items: flex-start;
}

.bullet-arrow {
  color: var(--accent-indigo);
  font-weight: 800;
  font-size: 1.1rem;
  line-height: 1;
}

.card-tech-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 0.45rem;
  margin-top: auto;
  padding-top: 1rem;
}

.tech-chip {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 600;
  background: var(--bg-subtle);
  color: var(--text-secondary);
  border: 1px solid var(--border-subtle);
  padding: 0.25rem 0.6rem;
  border-radius: var(--radius-sm);
}

.card-foot-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 1.25rem;
  margin-top: 1.25rem;
  border-top: 1px solid var(--border-subtle);
}

.link-action {
  font-size: 0.8125rem;
  font-weight: 700;
  color: var(--text-muted);
  transition: color var(--trans-fast);
}

.link-action:hover {
  color: var(--accent-indigo);
}

.btn-chip-demo {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.8125rem;
  font-weight: 700;
  color: var(--accent-indigo);
  background: rgba(99, 102, 241, 0.08);
  padding: 0.35rem 0.75rem;
  border-radius: var(--radius-full);
}

.btn-chip-demo:hover {
  background: var(--accent-indigo);
  color: #FFFFFF;
}

.glass-callout-strip {
  margin-top: 3rem;
  background: var(--bg-surface);
  border: 1px dashed var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 1.25rem 1.75rem;
  display: flex;
  align-items: center;
  gap: 1rem;
  font-size: 0.9rem;
  color: var(--text-secondary);
}

.callout-glyph {
  font-family: var(--font-mono);
  font-weight: 800;
  color: var(--accent-cyan);
  font-size: 1.25rem;
}

/* --------------------------------------------------------------------------
   ABOUT SECTION (#about)
   -------------------------------------------------------------------------- */
.about-3d-layout {
  display: grid;
  grid-template-columns: 290px 1.15fr 1fr;
  gap: 2rem;
  align-items: start;
}

/* Portrait Card Styling */
.about-portrait-card {
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
}

.portrait-img-wrap {
  position: relative;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
  border: 1px solid var(--border-glass);
  background: var(--bg-card);
  aspect-ratio: 1 / 1;
}

.portrait-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform var(--trans-medium);
}

.about-portrait-card:hover .portrait-img {
  transform: scale(1.03);
}

.portrait-status-badge {
  position: absolute;
  bottom: 0.75rem;
  left: 0.75rem;
  right: 0.75rem;
  background: rgba(15, 23, 42, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-full);
  padding: 0.35rem 0.65rem;
  display: flex;
  align-items: center;
  gap: 0.45rem;
  font-size: 0.72rem;
  font-weight: 600;
  color: #F8FAFC;
  justify-content: center;
}

.portrait-meta {
  margin-top: 1.25rem;
}

.portrait-name {
  font-family: var(--font-display);
  font-size: 1.15rem;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 0.2rem;
}

.portrait-title {
  font-size: 0.825rem;
  font-weight: 600;
  color: var(--accent-indigo);
  margin-bottom: 0.65rem;
}

.portrait-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.35rem;
  margin-bottom: 0.75rem;
}

.ptag {
  font-size: 0.7rem;
  font-weight: 600;
  color: var(--text-secondary);
  background: rgba(15, 23, 42, 0.04);
  padding: 0.2rem 0.45rem;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-glass);
}

.portrait-location {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.75rem;
  color: var(--text-muted);
}

.portrait-location svg {
  color: var(--accent-indigo);
  flex-shrink: 0;
}

.hero-avatar-thumb {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  object-fit: cover;
  border: 1.5px solid var(--accent-indigo);
  flex-shrink: 0;
  margin-right: 0.2rem;
}

.glass-panel-card {
  background: var(--bg-card);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--border-glass);
  border-radius: var(--radius-lg);
  padding: clamp(2rem, 4vw, 2.75rem);
  box-shadow: var(--shadow-glass);
}

.panel-heading {
  font-family: var(--font-display);
  font-size: 1.45rem;
  font-weight: 700;
  margin-bottom: 1.25rem;
  color: var(--text-primary);
}

.glass-panel-card p {
  color: var(--text-secondary);
  font-size: 1rem;
  margin-bottom: 1.2rem;
  line-height: 1.65;
}

.metrics-trio {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
  margin-top: 2rem;
  padding-top: 1.75rem;
  border-top: 1px solid var(--border-subtle);
}

.metric-box {
  display: flex;
  flex-direction: column;
}

.metric-num {
  font-family: var(--font-display);
  font-size: 1.65rem;
  font-weight: 800;
  color: var(--accent-indigo);
}

.metric-sub {
  font-size: 0.8125rem;
  color: var(--text-muted);
}

.pillars-container {
  display: flex;
  flex-direction: column;
  gap: 1.75rem;
}

.pillar-block {
  display: flex;
  gap: 1.25rem;
  align-items: flex-start;
}

.pillar-digit,
.pillar-icon {
  font-size: 0.85rem;
  font-weight: 800;
  color: var(--accent-indigo);
  background: rgba(30, 64, 175, 0.08);
  width: 28px;
  height: 28px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  line-height: 1;
}

.pillar-block h4 {
  font-family: var(--font-display);
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 0.25rem;
}

.pillar-block p {
  font-size: 0.875rem;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* --------------------------------------------------------------------------
   SKILLS SECTION (#skills)
   -------------------------------------------------------------------------- */
.skills-3d-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1.75rem;
}

.skill-3d-card {
  background: var(--bg-card);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--border-glass);
  border-radius: var(--radius-lg);
  padding: 2rem;
  box-shadow: var(--shadow-glass);
  transition: transform var(--trans-fast), border-color var(--trans-fast);
}

.skill-3d-card:hover {
  transform: translateY(-4px);
  border-color: var(--accent-indigo);
}

.skill-card-top {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  margin-bottom: 1.5rem;
}

.skill-num,
.skill-icon {
  font-size: 0.85rem;
  font-weight: 800;
  color: var(--accent-indigo);
  background: rgba(30, 64, 175, 0.08);
  width: 26px;
  height: 26px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  line-height: 1;
}

.skill-group-title {
  font-family: var(--font-display);
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--text-primary);
}

.skill-pills-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem;
}

.pill-tech {
  font-size: 0.8125rem;
  font-weight: 600;
  background: var(--bg-subtle);
  color: var(--text-primary);
  border: 1px solid var(--border-subtle);
  padding: 0.4rem 0.8rem;
  border-radius: var(--radius-sm);
  transition: all var(--trans-fast);
}

.pill-tech:hover {
  border-color: var(--accent-indigo);
  color: var(--accent-indigo);
  background: #FFFFFF;
  transform: scale(1.03);
}

/* --------------------------------------------------------------------------
   PROCESS SECTION (#process)
   -------------------------------------------------------------------------- */
.process-3d-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1.75rem;
}

.process-card {
  background: var(--bg-card);
  backdrop-filter: blur(20px);
  border: 1px solid var(--border-glass);
  border-radius: var(--radius-lg);
  padding: 2.25rem 1.75rem;
  box-shadow: var(--shadow-glass);
  transition: transform var(--trans-fast), border-color var(--trans-fast);
}

.process-card:hover {
  transform: translateY(-4px);
  border-color: var(--accent-cyan);
}

.process-phase {
  display: inline-block;
  font-family: var(--font-display);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--accent-indigo);
  background: rgba(30, 64, 175, 0.08);
  padding: 0.35rem 0.75rem;
  border-radius: var(--radius-full);
  margin-bottom: 1.25rem;
}

.process-name {
  font-family: var(--font-display);
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 0.75rem;
}

.process-body {
  font-size: 0.9rem;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* --------------------------------------------------------------------------
   EDUCATION SECTION (#education - Dual Stack with Honours)
   -------------------------------------------------------------------------- */
.education-dual-stack {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.edu-card-glass {
  background: var(--bg-card);
  backdrop-filter: blur(20px);
  border: 1px solid var(--border-glass);
  border-radius: var(--radius-lg);
  padding: clamp(2rem, 5vw, 3rem);
  box-shadow: var(--shadow-glass);
  transition: all var(--trans-normal);
}

.edu-card-glass.highlighted-card {
  border-color: rgba(99, 102, 241, 0.5);
  box-shadow: 0 16px 45px -10px rgba(99, 102, 241, 0.15), 0 0 0 1px var(--accent-indigo);
}

.edu-card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 1rem;
  margin-bottom: 1.25rem;
}

.edu-badge-level {
  font-family: var(--font-mono);
  font-size: 0.8125rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  color: var(--accent-indigo);
  text-transform: uppercase;
}

.edu-course-title {
  font-family: var(--font-display);
  font-size: 1.55rem;
  font-weight: 800;
  color: var(--text-primary);
  margin-top: 0.25rem;
}

.edu-uni-name {
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--text-secondary);
}

.edu-status-pill {
  padding: 0.4rem 1rem;
  border-radius: var(--radius-full);
  font-family: var(--font-mono);
  font-size: 0.8125rem;
  font-weight: 700;
}

.edu-status-pill.in-prog {
  background: rgba(99, 102, 241, 0.12);
  color: var(--accent-indigo);
  border: 1px solid rgba(99, 102, 241, 0.3);
}

.edu-status-pill.grad-21 {
  background: var(--status-green-bg);
  color: var(--status-green);
  border: 1px solid var(--status-green-border);
}

.edu-summary-text {
  font-size: 1rem;
  color: var(--text-secondary);
  line-height: 1.65;
  margin-bottom: 2rem;
  max-width: 860px;
}

.edu-modules-area {
  padding-top: 1.75rem;
  border-top: 1px solid var(--border-subtle);
}

.modules-caption {
  display: block;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--text-muted);
  margin-bottom: 0.85rem;
}

.module-tags-flex {
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem;
}

.tag-module {
  font-size: 0.8125rem;
  font-weight: 500;
  background: var(--bg-subtle);
  color: var(--text-secondary);
  border: 1px solid var(--border-subtle);
  padding: 0.35rem 0.85rem;
  border-radius: var(--radius-full);
}

/* --------------------------------------------------------------------------
   CONTACT SECTION (#contact)
   -------------------------------------------------------------------------- */
.contact-hologram-card {
  background: var(--bg-card);
  backdrop-filter: blur(25px);
  border: 1px solid var(--border-glass);
  border-radius: var(--radius-lg);
  padding: clamp(2.5rem, 6vw, 4.5rem);
  text-align: center;
  box-shadow: 0 25px 60px -15px rgba(99, 102, 241, 0.12);
  max-width: 920px;
  margin: 0 auto;
}

.contact-hero-title {
  font-family: var(--font-display);
  font-size: clamp(2.2rem, 5vw, 3.8rem);
  font-weight: 900;
  letter-spacing: -0.03em;
  color: var(--text-primary);
  margin-bottom: 1.25rem;
}

.contact-hero-desc {
  font-size: clamp(1rem, 1.8vw, 1.2rem);
  color: var(--text-secondary);
  max-width: 620px;
  margin: 0 auto 2.5rem auto;
  line-height: 1.6;
}

.contact-cta-buttons {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 1rem;
  margin-bottom: 2.75rem;
}

.btn-lg {
  padding: 1rem 2.2rem;
  font-size: 1rem;
}

.contact-network-strip {
  display: inline-flex;
  align-items: center;
  gap: 1rem;
  padding-top: 2rem;
  border-top: 1px solid var(--border-subtle);
  font-size: 0.9rem;
  color: var(--text-secondary);
}

.network-link {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  font-weight: 600;
  transition: color var(--trans-fast);
}

.network-link:hover {
  color: var(--accent-indigo);
}

.network-sep {
  color: var(--border-subtle);
}

/* --------------------------------------------------------------------------
   SITE FOOTER
   -------------------------------------------------------------------------- */
.site-footer {
  border-top: 1px solid var(--border-subtle);
  background: var(--bg-surface);
  backdrop-filter: blur(16px);
  padding: 2.5rem 0;
  position: relative;
  z-index: 1;
}

.footer-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1.5rem;
}

.footer-left {
  display: flex;
  flex-direction: column;
}

.footer-logo {
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 800;
  color: var(--text-primary);
}

.footer-sub {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--text-muted);
}

.footer-center {
  font-size: 0.85rem;
  color: var(--text-muted);
}

.btn-top-jump {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--text-secondary);
  padding: 0.4rem 0.8rem;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  background: #FFFFFF;
  transition: all var(--trans-fast);
}

.btn-top-jump:hover {
  border-color: var(--accent-indigo);
  color: var(--accent-indigo);
  transform: translateY(-2px);
}

/* --------------------------------------------------------------------------
   MODAL DIALOG
   -------------------------------------------------------------------------- */
.talk-modal-overlay {
  position: fixed;
  inset: 0;
  background: var(--bg-overlay);
  backdrop-filter: blur(12px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--trans-normal);
}

.talk-modal-overlay.open {
  opacity: 1;
  pointer-events: auto;
}

.talk-modal-card {
  background: #FFFFFF;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  width: 100%;
  max-width: 520px;
  box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.25);
  transform: scale(0.95) translateY(10px);
  transition: transform var(--trans-normal);
  overflow: hidden;
}

.talk-modal-overlay.open .talk-modal-card {
  transform: scale(1) translateY(0);
}

.modal-header {
  padding: 1.75rem 2rem;
  border-bottom: 1px solid var(--border-subtle);
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.modal-tag {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--accent-indigo);
}

.modal-title {
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-top: 0.25rem;
}

.modal-close-btn {
  color: var(--text-muted);
  padding: 0.4rem;
  border-radius: var(--radius-sm);
  transition: all var(--trans-fast);
}

.modal-close-btn:hover {
  color: var(--text-primary);
  background: var(--bg-subtle);
}

.modal-body {
  padding: 2rem;
}

.modal-quick-email {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--bg-subtle);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 0.85rem 1.15rem;
  margin-bottom: 1.5rem;
}

.quick-email-details {
  display: flex;
  flex-direction: column;
}

.quick-label {
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  font-weight: 700;
  color: var(--text-muted);
}

.quick-val {
  font-family: var(--font-mono);
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--text-primary);
}

.btn-copy-modal {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--accent-indigo);
  background: #FFFFFF;
  border: 1px solid var(--border-subtle);
  padding: 0.35rem 0.85rem;
  border-radius: var(--radius-sm);
  transition: all var(--trans-fast);
}

.btn-copy-modal:hover {
  background: var(--accent-indigo);
  color: #FFFFFF;
}

.modal-form {
  display: flex;
  flex-direction: column;
  gap: 1.15rem;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.form-group label {
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--text-primary);
}

.form-group input, .form-group textarea {
  font-family: var(--font-body);
  background: #FFFFFF;
  border: 1px solid var(--border-subtle);
  color: var(--text-primary);
  padding: 0.7rem 0.9rem;
  border-radius: var(--radius-md);
  font-size: 0.9rem;
  transition: border-color var(--trans-fast), box-shadow var(--trans-fast);
  width: 100%;
}

.form-group input:focus, .form-group textarea:focus {
  outline: none;
  border-color: var(--accent-indigo);
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
}

.form-group textarea {
  resize: vertical;
}

.btn-modal-submit {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
  font-size: 0.9375rem;
  font-weight: 700;
  color: #FFFFFF;
  background: var(--gradient-holo);
  padding: 0.85rem 1.5rem;
  border-radius: var(--radius-md);
  box-shadow: 0 4px 14px rgba(99, 102, 241, 0.3);
  margin-top: 0.5rem;
  transition: all var(--trans-fast);
}

.btn-modal-submit:hover {
  box-shadow: 0 6px 20px rgba(99, 102, 241, 0.45);
}

/* --------------------------------------------------------------------------
   TOAST NOTIFICATION
   -------------------------------------------------------------------------- */
.toast-card {
  position: fixed;
  bottom: 2rem;
  right: 2rem;
  background: var(--text-primary);
  color: #FFFFFF;
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
  padding: 0.85rem 1.35rem;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  gap: 0.65rem;
  font-size: 0.875rem;
  font-weight: 600;
  z-index: 2000;
  transform: translateY(160%);
  opacity: 0;
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  pointer-events: none;
}

.toast-card.show {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}

.toast-check {
  color: var(--status-green);
  font-weight: 800;
}

/* --------------------------------------------------------------------------
   RESPONSIVE BREAKPOINTS
   -------------------------------------------------------------------------- */
@media (max-width: 1100px) {
  .about-3d-layout {
    grid-template-columns: 1fr;
  }
  .about-portrait-card {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 1.75rem;
    align-items: center;
  }
}

@media (max-width: 992px) {
  .hero-grid {
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  .interactive-3d-stage {
    max-width: 380px;
  }
}

@media (max-width: 640px) {
  .about-portrait-card {
    display: flex;
    flex-direction: column;
    text-align: center;
  }
  .portrait-tags, .portrait-location {
    justify-content: center;
  }
}

@media (max-width: 768px) {
  .nav-menu, .btn-3d-subtle {
    display: none;
  }
  .mobile-nav-toggle {
    display: flex;
  }
  .custom-cursor-dot, .custom-cursor-ring {
    display: none;
  }
  .form-row {
    grid-template-columns: 1fr;
  }
  .metrics-trio {
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .footer-container {
    flex-direction: column;
    text-align: center;
  }
}
