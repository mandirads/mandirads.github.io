/**
 * Mandira Kalinga Dōna — 3D Web Portfolio JavaScript
 * Features:
 * 1. Interactive 3D WebGL / Three.js Geometric Scene with Mouse Tilt & Auto-Orbit
 * 2. High-Performance 2D Canvas Fallback (offline resilient)
 * 3. 3D Card Tilt Physics with Dynamic Specular Glare Tracking
 * 4. Custom Magnetic Cursor Indicator
 * 5. Project Category Filtering & "Let's Talk" Modal
 * 6. One-Click Email Copying & Toast Notification
 */

document.addEventListener('DOMContentLoaded', () => {
  const emailAddress = 'mkavindidesilva@gmail.com';

  // --------------------------------------------------------------------------
  // 1. Dynamic Copyright Year
  // --------------------------------------------------------------------------
  const yearEl = document.getElementById('currentYear');
  if (yearEl) yearEl.textContent = new Date().getFullYear();

  // --------------------------------------------------------------------------
  // 2. Custom Magnetic Cursor
  // --------------------------------------------------------------------------
  const cursorDot = document.getElementById('cursorDot');
  const cursorRing = document.getElementById('cursorRing');

  if (cursorDot && cursorRing && window.matchMedia('(pointer: fine)').matches) {
    let mouseX = window.innerWidth / 2;
    let mouseY = window.innerHeight / 2;
    let ringX = mouseX;
    let ringY = mouseY;

    window.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      cursorDot.style.transform = `translate(${mouseX}px, ${mouseY}px)`;
    });

    function renderCursor() {
      ringX += (mouseX - ringX) * 0.15;
      ringY += (mouseY - ringY) * 0.15;
      cursorRing.style.transform = `translate(${ringX}px, ${ringY}px)`;
      requestAnimationFrame(renderCursor);
    }
    renderCursor();

    const interactives = document.querySelectorAll('a, button, input, textarea, .card-3d-tilt');
    interactives.forEach(el => {
      el.addEventListener('mouseenter', () => {
        cursorRing.style.width = '52px';
        cursorRing.style.height = '52px';
        cursorRing.style.borderColor = 'rgba(99, 102, 241, 0.7)';
      });
      el.addEventListener('mouseleave', () => {
        cursorRing.style.width = '32px';
        cursorRing.style.height = '32px';
        cursorRing.style.borderColor = 'rgba(99, 102, 241, 0.4)';
      });
    });
  }

  // --------------------------------------------------------------------------
  // 3. Interactive 3D Data Sphere / Network Matrix (Three.js WebGL)
  // --------------------------------------------------------------------------
  const canvas3d = document.getElementById('hero3dCanvas');

  if (canvas3d) {
    if (typeof THREE !== 'undefined') {
      initThreeJsSphereMatrix(canvas3d);
    } else {
      initCanvasSphereMatrixFallback(canvas3d);
    }
  }

  function initThreeJsSphereMatrix(canvas) {
    try {
      const scene = new THREE.Scene();
      const rect = canvas.getBoundingClientRect();
      const width = rect.width || 420;
      const height = rect.height || 480;

      // Camera positioned with generous clearance so NO part of the sphere or rings is ever clipped
      const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
      camera.position.z = 6.6;

      const renderer = new THREE.WebGLRenderer({ canvas: canvas, alpha: true, antialias: true });
      renderer.setSize(width, height);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      // Master 3D Data Sphere Group
      const matrixGroup = new THREE.Group();
      scene.add(matrixGroup);

      // 1. True Mathematical Round Sphere Network Matrix (SphereGeometry - No box/faceted shell)
      const sphereRadius = 1.45;
      const sphereGeo = new THREE.SphereGeometry(sphereRadius, 32, 22);

      // Delicate Blueprint Network Wireframe
      const wireframeGeo = new THREE.WireframeGeometry(sphereGeo);
      const wireMat = new THREE.LineBasicMaterial({
        color: 0x2563EB,
        transparent: true,
        opacity: 0.45,
        blending: THREE.AdditiveBlending
      });
      const wireMesh = new THREE.LineSegments(wireframeGeo, wireMat);
      matrixGroup.add(wireMesh);

      // 2. Interconnected Glowing Network Nodes (placed precisely on the sphere surface)
      const posAttr = sphereGeo.attributes.position;
      const uniquePoints = [];
      const seen = new Set();
      for (let i = 0; i < posAttr.count; i++) {
        const y = posAttr.getY(i);
        if (Math.abs(y) > sphereRadius * 0.96) continue; // Skip dense polar clusters for visual elegance
        const x = Math.round(posAttr.getX(i) * 100) / 100;
        const z = Math.round(posAttr.getZ(i) * 100) / 100;
        const key = `${x},${Math.round(y * 100) / 100},${z}`;
        if (!seen.has(key)) {
          seen.add(key);
          uniquePoints.push(new THREE.Vector3(posAttr.getX(i), y, posAttr.getZ(i)));
        }
      }

      const nodesGeo = new THREE.BufferGeometry().setFromPoints(uniquePoints);
      const nodesMat = new THREE.PointsMaterial({
        size: 0.085,
        color: 0x06B6D4,
        transparent: true,
        opacity: 0.95,
        blending: THREE.AdditiveBlending
      });
      const nodesMesh = new THREE.Points(nodesGeo, nodesMat);
      matrixGroup.add(nodesMesh);

      // 3. Cyber Orbital Data Rings (proportional and kept 100% inside canvas)
      // Ring A (Cyan Primary Data Orbit)
      const ringGeoA = new THREE.TorusGeometry(1.85, 0.015, 16, 120);
      const ringMatA = new THREE.MeshStandardMaterial({
        color: 0x06B6D4,
        roughness: 0.2,
        metalness: 0.85,
        emissive: 0x06B6D4,
        emissiveIntensity: 0.45,
        transparent: true,
        opacity: 0.85
      });
      const ringA = new THREE.Mesh(ringGeoA, ringMatA);
      ringA.rotation.x = Math.PI * 0.35;
      ringA.rotation.y = Math.PI * 0.12;
      matrixGroup.add(ringA);

      // Ring B (Cobalt Secondary Tilted Orbit - No Purple)
      const ringGeoB = new THREE.TorusGeometry(2.05, 0.012, 16, 120);
      const ringMatB = new THREE.MeshStandardMaterial({
        color: 0x1D4ED8,
        roughness: 0.25,
        metalness: 0.8,
        emissive: 0x1E40AF,
        emissiveIntensity: 0.4,
        transparent: true,
        opacity: 0.78
      });
      const ringB = new THREE.Mesh(ringGeoB, ringMatB);
      ringB.rotation.x = -Math.PI * 0.28;
      ringB.rotation.z = Math.PI * 0.2;
      matrixGroup.add(ringB);

      // 4. Data Packet Beacons Traveling in Real-Time along Cyber Rings
      const beaconGeo = new THREE.SphereGeometry(0.055, 12, 12);
      const beaconMatA = new THREE.MeshBasicMaterial({ color: 0x22D3EE });
      const beaconA = new THREE.Mesh(beaconGeo, beaconMatA);
      ringA.add(beaconA);

      const beaconMatB = new THREE.MeshBasicMaterial({ color: 0x60A5FA });
      const beaconB = new THREE.Mesh(beaconGeo, beaconMatB);
      ringB.add(beaconB);

      // 5. Pulsing Holographic Inner Spherical Core (Deep Matte Cobalt / Navy)
      const coreGeo = new THREE.SphereGeometry(0.5, 24, 20);
      const coreMat = new THREE.MeshStandardMaterial({
        color: 0x1E40AF,
        roughness: 0.2,
        metalness: 0.9,
        emissive: 0x1D4ED8,
        emissiveIntensity: 0.55,
        transparent: true,
        opacity: 0.88
      });
      const innerCore = new THREE.Mesh(coreGeo, coreMat);
      matrixGroup.add(innerCore);

      const coreWireGeo = new THREE.SphereGeometry(0.51, 14, 10);
      const coreWireMat = new THREE.MeshBasicMaterial({
        color: 0xA5F3FC,
        wireframe: true,
        transparent: true,
        opacity: 0.75
      });
      const innerCoreWire = new THREE.Mesh(coreWireGeo, coreWireMat);
      matrixGroup.add(innerCoreWire);

      // 6. Ambient Orbiting Data Particle Constellation (tight orbit, zero clipping)
      const particlesGeo = new THREE.BufferGeometry();
      const particleCount = 130;
      const posArray = new Float32Array(particleCount * 3);
      for (let i = 0; i < particleCount * 3; i += 3) {
        const theta = Math.random() * Math.PI * 2;
        const phi = (Math.random() - 0.5) * Math.PI * 0.85;
        const r = 2.0 + Math.random() * 0.28; // Stays safely within r=2.28 (frustum extent is 2.73)
        posArray[i] = r * Math.cos(theta) * Math.cos(phi);
        posArray[i + 1] = r * Math.sin(phi) * 0.85;
        posArray[i + 2] = r * Math.sin(theta) * Math.cos(phi);
      }
      particlesGeo.setAttribute('position', new THREE.BufferAttribute(posArray, 3));
      const particlesMat = new THREE.PointsMaterial({
        size: 0.034,
        color: 0x06B6D4,
        transparent: true,
        opacity: 0.85,
        blending: THREE.AdditiveBlending
      });
      const particleCloud = new THREE.Points(particlesGeo, particlesMat);
      scene.add(particleCloud);

      // 7. Multi-Point Studio Lighting
      const ambientLight = new THREE.AmbientLight(0xffffff, 1.4);
      scene.add(ambientLight);

      const pointLight1 = new THREE.PointLight(0x06B6D4, 3.2, 35);
      pointLight1.position.set(4, 3, 5);
      scene.add(pointLight1);

      const pointLight2 = new THREE.PointLight(0x2563EB, 2.8, 30);
      pointLight2.position.set(-4, -2, -3);
      scene.add(pointLight2);

      const pointLightCore = new THREE.PointLight(0x22D3EE, 3.0, 16);
      pointLightCore.position.set(0, 0, 0);
      matrixGroup.add(pointLightCore);

      // 8. Interactive Physics: Drag-to-Spin + Mouse Orbit
      let targetRotX = 0;
      let targetRotY = 0;
      let isDragging = false;
      let prevMouseX = 0;
      let prevMouseY = 0;
      let dragVelocityX = 0;
      let dragVelocityY = 0;

      canvas.addEventListener('mousedown', (e) => {
        isDragging = true;
        prevMouseX = e.clientX;
        prevMouseY = e.clientY;
      });

      window.addEventListener('mouseup', () => {
        isDragging = false;
      });

      canvas.addEventListener('touchstart', (e) => {
        if (e.touches.length === 1) {
          isDragging = true;
          prevMouseX = e.touches[0].clientX;
          prevMouseY = e.touches[0].clientY;
        }
      }, { passive: true });

      window.addEventListener('touchend', () => {
        isDragging = false;
      });

      window.addEventListener('touchmove', (e) => {
        if (isDragging && e.touches.length === 1) {
          const deltaX = e.touches[0].clientX - prevMouseX;
          const deltaY = e.touches[0].clientY - prevMouseY;
          prevMouseX = e.touches[0].clientX;
          prevMouseY = e.touches[0].clientY;

          dragVelocityX = deltaX * 0.007;
          dragVelocityY = deltaY * 0.007;

          matrixGroup.rotation.y += dragVelocityX;
          matrixGroup.rotation.x += dragVelocityY;
        }
      }, { passive: true });

      window.addEventListener('mousemove', (e) => {
        if (isDragging) {
          const deltaX = e.clientX - prevMouseX;
          const deltaY = e.clientY - prevMouseY;
          prevMouseX = e.clientX;
          prevMouseY = e.clientY;

          dragVelocityX = deltaX * 0.007;
          dragVelocityY = deltaY * 0.007;

          matrixGroup.rotation.y += dragVelocityX;
          matrixGroup.rotation.x += dragVelocityY;
        } else {
          const normX = (e.clientX / window.innerWidth) - 0.5;
          const normY = (e.clientY / window.innerHeight) - 0.5;
          targetRotY = normX * 1.4;
          targetRotX = normY * 1.4;
        }
      });

      // 9. Animation Loop
      let clock = new THREE.Clock();
      function animate() {
        requestAnimationFrame(animate);

        const time = clock.getElapsedTime();

        // Gentle levitation
        matrixGroup.position.y = Math.sin(time * 1.8) * 0.07;

        // Continuous rotational spin
        matrixGroup.rotation.y += 0.005;
        matrixGroup.rotation.x += 0.002;

        // Data beacons orbiting along cyber rings (matching updated ring radii)
        const beaconAngleA = time * 2.2;
        beaconA.position.set(Math.cos(beaconAngleA) * 1.85, Math.sin(beaconAngleA) * 1.85, 0);

        const beaconAngleB = -time * 1.9;
        beaconB.position.set(Math.cos(beaconAngleB) * 2.05, Math.sin(beaconAngleB) * 2.05, 0);

        // Counter-rotating inner spherical core
        innerCore.rotation.y -= 0.012;
        innerCore.rotation.z += 0.008;
        innerCoreWire.rotation.y -= 0.012;
        innerCoreWire.rotation.z += 0.008;

        // Pulsing heartbeat on inner core light
        pointLightCore.intensity = 2.4 + Math.sin(time * 4) * 0.7;

        if (!isDragging) {
          dragVelocityX *= 0.93;
          dragVelocityY *= 0.93;
          matrixGroup.rotation.y += dragVelocityX;
          matrixGroup.rotation.x += dragVelocityY;

          // Smoothly interpolate towards mouse target when idle
          matrixGroup.rotation.y += (targetRotY - matrixGroup.rotation.y) * 0.04;
          matrixGroup.rotation.x += (targetRotX - matrixGroup.rotation.x) * 0.04;
        }

        // Orbit particle cloud
        particleCloud.rotation.y += 0.0014;
        particleCloud.rotation.x -= 0.0006;

        renderer.render(scene, camera);
      }
      animate();

      // Handle Resize
      window.addEventListener('resize', () => {
        const newRect = canvas.getBoundingClientRect();
        const newW = newRect.width || 480;
        const newH = newRect.height || 480;
        camera.aspect = newW / newH;
        camera.updateProjectionMatrix();
        renderer.setSize(newW, newH);
      });

    } catch (err) {
      console.warn('Three.js Data Sphere initialization failed, switching to 2D canvas fallback:', err);
      initCanvasSphereMatrixFallback(canvas);
    }
  }

  // 3D Canvas Fallback (Self-contained mathematical 3D Data Sphere projection)
  function initCanvasSphereMatrixFallback(canvas) {
    const ctx = canvas.getContext('2d');
    const dpr = window.devicePixelRatio || 1;
    let width, height;

    function resize() {
      const rect = canvas.getBoundingClientRect();
      width = rect.width || 380;
      height = rect.height || 380;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.scale(dpr, dpr);
    }
    resize();
    window.addEventListener('resize', resize);

    // Generate sphere latitude & longitude network points
    const latCount = 10;
    const lonCount = 18;
    const spherePoints = [];
    for (let lat = 0; lat <= latCount; lat++) {
      const theta = (lat / latCount) * Math.PI;
      for (let lon = 0; lon <= lonCount; lon++) {
        const phi = (lon / lonCount) * Math.PI * 2;
        const x = Math.sin(theta) * Math.cos(phi);
        const y = Math.cos(theta);
        const z = Math.sin(theta) * Math.sin(phi);
        spherePoints.push([x, y, z]);
      }
    }

    let rotX = 0.2;
    let rotY = 0.2;
    let targetRotX = 0.2;
    let targetRotY = 0.2;

    window.addEventListener('mousemove', (e) => {
      const normX = (e.clientX / window.innerWidth) - 0.5;
      const normY = (e.clientY / window.innerHeight) - 0.5;
      targetRotY = normX * 1.8;
      targetRotX = normY * 1.8;
    });

    function draw() {
      ctx.clearRect(0, 0, width, height);

      rotY += 0.006 + (targetRotY - rotY) * 0.05;
      rotX += 0.003 + (targetRotX - rotX) * 0.05;

      // Sized comfortably so nothing touches canvas edges
      const scale = width * 0.28;
      const cx = width / 2;
      const cy = height / 2;

      const projected = spherePoints.map(v => {
        let x1 = v[0] * Math.cos(rotY) + v[2] * Math.sin(rotY);
        let y1 = v[1];
        let z1 = -v[0] * Math.sin(rotY) + v[2] * Math.cos(rotY);

        let x2 = x1;
        let y2 = y1 * Math.cos(rotX) - z1 * Math.sin(rotX);
        let z2 = y1 * Math.sin(rotX) + z1 * Math.cos(rotX);

        const dist = 3.5;
        const fov = dist / (dist + z2);
        return [cx + x2 * scale * fov, cy + y2 * scale * fov, z2];
      });

      // Draw subtle orbital ring
      ctx.beginPath();
      ctx.ellipse(cx, cy, scale * 1.25, scale * 0.45, rotY * 0.5, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(6, 182, 212, 0.45)';
      ctx.lineWidth = 1.5;
      ctx.stroke();

      // Draw network points with depth opacity
      projected.forEach(p => {
        const depthAlpha = Math.max(0.15, (p[2] + 1) * 0.45);
        ctx.fillStyle = `rgba(99, 102, 241, ${depthAlpha})`;
        ctx.beginPath();
        ctx.arc(p[0], p[1], Math.max(1.2, (p[2] + 1) * 2), 0, Math.PI * 2);
        ctx.fill();
      });

      requestAnimationFrame(draw);
    }
    draw();
  }

  // --------------------------------------------------------------------------
  // 4. Interactive 3D Background Engine (Hero Depth Network & Horizon Matrix)
  // --------------------------------------------------------------------------
  const bgCanvas = document.getElementById('heroBg3dCanvas');
  if (bgCanvas) {
    initHero3DBackground(bgCanvas);
  }

  function initHero3DBackground(canvas) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let dpr = 1;

    function resize() {
      const heroSection = canvas.parentElement;
      const rect = heroSection ? heroSection.getBoundingClientRect() : { width: window.innerWidth, height: 700 };
      width = rect.width || window.innerWidth;
      height = rect.height || 700;
      dpr = Math.min(window.devicePixelRatio || 1, 2);

      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.resetTransform?.();
      ctx.scale(dpr, dpr);
    }
    resize();
    window.addEventListener('resize', resize);

    // 3D Spatial Matrix Nodes distributed across width, height, and depth Z (-250 to 250)
    const nodeCount = Math.min(65, Math.floor(width / 22));
    const nodes = [];
    for (let i = 0; i < nodeCount; i++) {
      nodes.push({
        x: (Math.random() - 0.5) * width * 1.1,
        y: (Math.random() - 0.5) * height * 0.95,
        z: (Math.random() - 0.5) * 450,
        vx: (Math.random() - 0.5) * 0.28,
        vy: (Math.random() - 0.5) * 0.28,
        vz: (Math.random() - 0.5) * 0.4,
        size: 1.5 + Math.random() * 2.2,
        isAccent: Math.random() > 0.65,
        tag: Math.random() > 0.85 ? `[0x${Math.floor(Math.random() * 256).toString(16).toUpperCase()}]` : null
      });
    }

    // Mouse Parallax & Dynamic Horizon Tilt
    let mouseX = 0;
    let mouseY = 0;
    let targetMouseX = 0;
    let targetMouseY = 0;

    window.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      const inX = e.clientX - rect.left;
      const inY = e.clientY - rect.top;
      targetMouseX = ((inX / width) - 0.5) * 120;
      targetMouseY = ((inY / height) - 0.5) * 80;
    });

    let frame = 0;
    function renderBg() {
      requestAnimationFrame(renderBg);
      frame++;

      ctx.clearRect(0, 0, width, height);

      // Smooth interpolation for mouse parallax
      mouseX += (targetMouseX - mouseX) * 0.05;
      mouseY += (targetMouseY - mouseY) * 0.05;

      const cx = width * 0.48 + mouseX * 0.4;
      const cy = height * 0.46 + mouseY * 0.4;
      const fov = 480;

      // 1. Project 3D Spatial Nodes and Calculate Depths (No harsh grid lines or bounding boxes)
      const projected = [];
      for (let i = 0; i < nodes.length; i++) {
        const n = nodes[i];

        // Autonomous gentle 3D drift
        n.x += n.vx;
        n.y += n.vy;
        n.z += n.vz;

        // Bounding volume bounce
        const boundX = width * 0.58;
        const boundY = height * 0.52;
        if (Math.abs(n.x) > boundX) n.vx *= -1;
        if (Math.abs(n.y) > boundY) n.vy *= -1;
        if (Math.abs(n.z) > 240) n.vz *= -1;

        // Depth projection with stereoscopic parallax
        const effectiveZ = n.z + 300;
        const scale = fov / (fov + effectiveZ);
        const px = cx + (n.x - mouseX * (1 + n.z / 250)) * scale;
        const py = cy + (n.y - mouseY * (1 + n.z / 250)) * scale;
        const depthAlpha = Math.min(0.75, Math.max(0.12, (240 - n.z) / 480));

        projected.push({ x: px, y: py, z: n.z, scale, alpha: depthAlpha, node: n });
      }

      // 3. Draw Interconnecting Matrix Lines in 3D Space
      const maxConnectDist = 135;
      for (let i = 0; i < projected.length; i++) {
        for (let j = i + 1; j < projected.length; j++) {
          const p1 = projected[i];
          const p2 = projected[j];
          const dx = p1.x - p2.x;
          const dy = p1.y - p2.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < maxConnectDist) {
            const lineAlpha = (1 - (dist / maxConnectDist)) * Math.min(p1.alpha, p2.alpha) * 0.45;
            ctx.beginPath();
            ctx.moveTo(p1.x, p1.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.strokeStyle = p1.node.isAccent
              ? `rgba(6, 182, 212, ${lineAlpha})`
              : `rgba(99, 102, 241, ${lineAlpha})`;
            ctx.lineWidth = 0.85;
            ctx.stroke();
          }
        }
      }

      // 4. Draw Glowing 3D Nodes & Coordinate Crosshairs
      for (let i = 0; i < projected.length; i++) {
        const p = projected[i];
        const r = Math.max(1, p.node.size * p.scale);

        // Core dot
        ctx.beginPath();
        ctx.arc(p.x, p.y, r, 0, Math.PI * 2);
        ctx.fillStyle = p.node.isAccent
          ? `rgba(6, 182, 212, ${p.alpha})`
          : `rgba(99, 102, 241, ${p.alpha})`;
        ctx.fill();

        // Subtle 3D tech crosshair on accent nodes
        if (p.node.isAccent && p.scale > 0.85) {
          ctx.strokeStyle = `rgba(6, 182, 212, ${p.alpha * 0.4})`;
          ctx.lineWidth = 0.75;
          const arm = 4;
          ctx.beginPath();
          ctx.moveTo(p.x - arm, p.y);
          ctx.lineTo(p.x + arm, p.y);
          ctx.moveTo(p.x, p.y - arm);
          ctx.lineTo(p.x, p.y + arm);
          ctx.stroke();

          // Coordinate label tag
          if (p.node.tag) {
            ctx.font = '9px "JetBrains Mono", monospace';
            ctx.fillStyle = `rgba(99, 102, 241, ${p.alpha * 0.65})`;
            ctx.fillText(p.node.tag, p.x + 6, p.y - 4);
          }
        }
      }
    }
    renderBg();
  }

  // --------------------------------------------------------------------------
  // 4. Interactive 3D Card Tilt Physics with Glare Reflection
  // --------------------------------------------------------------------------
  const tiltCards = document.querySelectorAll('.card-3d-tilt');

  tiltCards.forEach(card => {
    const glare = card.querySelector('.card-glare');

    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      const centerX = rect.width / 2;
      const centerY = rect.height / 2;

      const rotateX = ((y - centerY) / centerY) * -9; // Max 9 deg tilt
      const rotateY = ((x - centerX) / centerX) * 9;

      card.style.transform = `perspective(1000px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) scale3d(1.02, 1.02, 1.02)`;

      if (glare) {
        const glareX = (x / rect.width) * 100;
        const glareY = (y / rect.height) * 100;
        glare.style.background = `radial-gradient(circle at ${glareX}% ${glareY}%, rgba(255, 255, 255, 0.45) 0%, transparent 60%)`;
      }
    });

    card.addEventListener('mouseleave', () => {
      card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
    });
  });

  // --------------------------------------------------------------------------
  // 5. Mobile Navigation Drawer
  // --------------------------------------------------------------------------
  const mobileMenuToggle = document.getElementById('mobileMenuToggle');
  const mobileDrawer = document.getElementById('mobileDrawer');

  if (mobileMenuToggle && mobileDrawer) {
    mobileMenuToggle.addEventListener('click', () => {
      const isOpen = mobileDrawer.classList.toggle('open');
      mobileMenuToggle.setAttribute('aria-expanded', isOpen.toString());
    });

    const drawerLinks = mobileDrawer.querySelectorAll('.mobile-drawer-link');
    drawerLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileDrawer.classList.remove('open');
        mobileMenuToggle.setAttribute('aria-expanded', 'false');
      });
    });
  }

  // --------------------------------------------------------------------------
  // 6. Project Category Filter
  // --------------------------------------------------------------------------
  const filterChips = document.querySelectorAll('.filter-chip');
  const projectCards = document.querySelectorAll('.card-3d-tilt');

  filterChips.forEach(chip => {
    chip.addEventListener('click', () => {
      const filter = chip.getAttribute('data-filter');

      filterChips.forEach(c => {
        c.classList.remove('is-active');
        c.setAttribute('aria-selected', 'false');
      });
      chip.classList.add('is-active');
      chip.setAttribute('aria-selected', 'true');

      projectCards.forEach(card => {
        const cat = card.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          card.classList.remove('hidden');
          card.style.opacity = '0';
          card.style.transform = 'translateY(12px)';
          setTimeout(() => {
            card.style.opacity = '1';
            card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
          }, 40);
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });

  // --------------------------------------------------------------------------
  // 7. "Let's Talk" Modal Dialog
  // --------------------------------------------------------------------------
  const talkModal = document.getElementById('talkModal');
  const openTalkBtns = document.querySelectorAll('.js-open-talk');
  const modalCloseBtn = document.getElementById('modalCloseBtn');
  const modalContactForm = document.getElementById('modalContactForm');

  function openModal() {
    if (talkModal) {
      talkModal.classList.add('open');
      talkModal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeModal() {
    if (talkModal) {
      talkModal.classList.remove('open');
      talkModal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  }

  openTalkBtns.forEach(btn => btn.addEventListener('click', openModal));
  if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);

  if (talkModal) {
    talkModal.addEventListener('click', (e) => {
      if (e.target === talkModal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && talkModal.classList.contains('open')) closeModal();
    });
  }

  if (modalContactForm) {
    modalContactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = document.getElementById('mName')?.value.trim() || '';
      const email = document.getElementById('mEmail')?.value.trim() || '';
      const subject = document.getElementById('mSubject')?.value.trim() || 'Software Engineer Inquiry';
      const message = document.getElementById('mMessage')?.value.trim() || '';

      const emailSubject = encodeURIComponent(`[Portfolio Inquiry] ${subject}`);
      const emailBody = encodeURIComponent(`Hi Mandira,\n\n${message}\n\nFrom: ${name} (${email})`);

      window.location.href = `mailto:${emailAddress}?subject=${emailSubject}&body=${emailBody}`;
      showToast('Opening your email client...');
      closeModal();
      modalContactForm.reset();
    });
  }

  // --------------------------------------------------------------------------
  // 8. Toast Notification & Copy Email
  // --------------------------------------------------------------------------
  const toastEl = document.getElementById('toastNotification');
  const toastMsg = document.getElementById('toastMessage');
  let toastTimer;

  function showToast(message) {
    if (!toastEl || !toastMsg) return;
    toastMsg.textContent = message;
    toastEl.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      toastEl.classList.remove('show');
    }, 3000);
  }

  function copyEmail() {
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(emailAddress)
        .then(() => showToast(`Copied: ${emailAddress}`))
        .catch(() => fallbackCopy(emailAddress));
    } else {
      fallbackCopy(emailAddress);
    }
  }

  function fallbackCopy(text) {
    const temp = document.createElement('textarea');
    temp.value = text;
    temp.style.position = 'fixed';
    temp.style.left = '-9999px';
    document.body.appendChild(temp);
    temp.focus();
    temp.select();
    try {
      document.execCommand('copy');
      showToast(`Copied: ${text}`);
    } catch {
      showToast(`Email: ${text}`);
    }
    document.body.removeChild(temp);
  }

  const quickCopyEmailBtn = document.getElementById('quickCopyEmailBtn');
  const modalCopyEmailBtn = document.getElementById('modalCopyEmailBtn');
  const copyEmailContactBtn = document.getElementById('copyEmailContactBtn');

  if (quickCopyEmailBtn) quickCopyEmailBtn.addEventListener('click', copyEmail);
  if (modalCopyEmailBtn) modalCopyEmailBtn.addEventListener('click', copyEmail);
  if (copyEmailContactBtn) {
    copyEmailContactBtn.addEventListener('click', (e) => {
      e.preventDefault();
      copyEmail();
    });
  }

  // --------------------------------------------------------------------------
  // 9. Active Nav Highlighting on Scroll
  // --------------------------------------------------------------------------
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('.nav-menu .nav-link');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute('id');
        navLinks.forEach(link => {
          if (link.getAttribute('href') === `#${id}`) {
            link.classList.add('active');
          } else {
            link.classList.remove('active');
          }
        });
      }
    });
  }, { threshold: 0.25 });

  sections.forEach(sec => observer.observe(sec));
});
